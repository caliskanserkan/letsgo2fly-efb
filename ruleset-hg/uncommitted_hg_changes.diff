+  return `${label} ${standbyDuty.duty_date} ${hhmm(standbyDuty.report_time)}–${hhmm(standbyDuty.duty_end)}Z `
+       + `(${fmtMin(effect.standbyMin)}, ${effect.reference}) → FDP −${fmtMin(effect.fdpReductionMin)}`;
+}

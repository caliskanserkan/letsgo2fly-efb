+    blocks, blocksOf2: blocks.filter(b => b.length >= 2).length,
+    groupingOk: month == null ? null : blocks.filter(b => b.length >= 2).length >= minBlocks2,
+    firstHalf, secondHalf,
+    balancedOk: month == null ? null : (firstHalf > 0 && secondHalf > 0),
+  };
+}

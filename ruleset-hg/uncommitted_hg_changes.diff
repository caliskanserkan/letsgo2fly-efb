+  if (extensionExceeded) {
+    reasons.push(`SKPK FDP EXTENSION ${fmtMin(ext)} > ${fmtMin(extMax)} MAX${ctx.augmented ? ' (augmented crew)' : ''} (SHT-FTL/HG Md.12/1/a)`);
+  }
+
+  // — Md.12(2) kısaltma tavanı + 10 saat tabanı
